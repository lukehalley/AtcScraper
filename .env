# Misc Settings
TIMER_STR_FORMAT="%-M Mins %-S Secs"

# Dex Screener #######################
#Settings
DS_TIMEFRAMES="24H"
#DS_TIMEFRAMES="5M,1H,6H,24H"
DS_TX_COUNT_FLOOR=100

# Parent Selectors
DS_ROOT_URL="https://dexscreener.com"
DS_PANEL="#root > div > main"
DS_SIDEBAR="#root > div > nav"
DS_LIST="#root > div > nav"

# Panel Selectors
DS_DEX_TABS="#root > div > main > div > ul"
DS_DEX_TABLE="#root > div > main > div > div"
DS_DEX_TABLE_XPATH='//*[@id="root"]/div/main/div/div/div[2]'
DS_DEX_TABLE_TIMEFRAME_MENU="body > div:nth-child(5) > div"

DS_LOADER="#root > div > main > div > div > div > div > div > span"
DS_TABLE_LOADER="#root > div > main > div > div > div.css-v0p5eh > div"
DS_TX_COUNT="#root > div > main > div > div > div > div.css-ht49jx > div.chakra-wrap.css-zfarrx > ul > li.chakra-wrap__listitem.css-1yp4ln > div > div:nth-child(1) > span.chakra-text.css-2ygcmq > div"

# Panel Sorters
DS_SORT_BY_LIQUIDITY="#root > div > main > div > div.css-j3hajj > div.css-1m4s57r > div:nth-child(9)"

# Panel Classes
DS_DEX_ROW_CLASS="chakra-link.css-1oo4dn7"
DS_DEX_UNISWAP_BADGE_CLASS="chakra-badge css-1hazpft"

# Token Page Selectors
